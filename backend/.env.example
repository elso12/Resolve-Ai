# ── ResolveAI Backend Environment Configuration Template ─────────────────────────────
# Copy this file to `.env` in the backend directory and configure your secrets.

PROJECT_NAME=ResolveAI
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# Security & Authentication — REQUIRED in production
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL with pgvector or SQLite for local dev)
# PostgreSQL Production: postgresql+asyncpg://postgres:postgres@localhost:5432/resolveai
# SQLite Local Dev: sqlite+aiosqlite:///./local_dev.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/resolveai

# Redis (Caching, Pub/Sub & WebSockets)
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI & LLM Provider Keys (OpenAI / Instructor)
OPENAI_API_KEY=your-openai-api-key-here

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=false
